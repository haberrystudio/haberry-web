# Copy to .env.local and fill in. Set the real HTTPS origin for production builds.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP=            # digits only with country code, e.g. 919xxxxxxxxx
NEXT_PUBLIC_PHONE=               # e.g. +919xxxxxxxxx
NEXT_PUBLIC_EMAIL=               # e.g. hello@haberry.in
NEXT_PUBLIC_FORM_ENDPOINT=       # Formspree / Web3Forms / your own POST endpoint that accepts JSON
NEXT_PUBLIC_GTM_ID=              # Google Tag Manager container ID (default: GTM-WPZTBWG6)
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_YOUTUBE=
